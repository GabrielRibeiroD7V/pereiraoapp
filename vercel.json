{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/check-asaas-sandbox.mjs",
  "functions": {
    "api/sandbox-billing.ts": {
      "maxDuration": 60,
      "includeFiles": "public/images/brand/pereirao-384.png"
    },
    "api/asaas-webhook.ts": { "maxDuration": 60 },
    "api/asaas-production-webhook.ts": { "maxDuration": 60 },
    "api/production-billing-recovery.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/admin", "destination": "/api/admin" },
    { "source": "/api/sandbox-billing", "destination": "/api/sandbox-billing" },
    { "source": "/api/asaas-webhook", "destination": "/api/asaas-webhook" },
    { "source": "/api/asaas-production-webhook", "destination": "/api/asaas-production-webhook" },
    { "source": "/api/production-billing-recovery", "destination": "/api/production-billing-recovery" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/pwa/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
